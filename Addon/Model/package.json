{
  "name": "model",
  "version": "1.3.0",
  "main": "index.js",
  "type": "module",
  "description": "Model addon with shadow mapping support",
  "scripts": {
    "test": "http-server ./ -p 8080 --cors -c-1",
    "build-clean": "rimraf dist",
    "build-clean-modules": "rimraf ../modules",
    "build-dist": "rollup -c",
    "build-worker": "rollup -c rollup.worker.config.js",
    "watch": "rollup -c -w",
    "watch-worker": "rollup -c rollup.worker.config.js -w",
    "copy": "copyfiles -u 1 \"dist/**/*\" ../modules",
    "copy-workers": "copyfiles -u 1 \"dist/workers/**/*\" ../modules/",
    "copy-gl-matrix-minimal": "copyfiles -u 1 src/gl-matrix-minimal.js ../modules/ && node -e \"require('fs').renameSync('../modules/gl-matrix-minimal.js', '../modules/gl-matrix.js')\"",
    "build": "npm run build-clean && npm run build-clean-modules && npm run build-dist && npm run build-worker && npm run copy && npm run copy-workers && npm run copy-gl-matrix-minimal",
    "docs": "typedoc --out docs src/ShadowMapManager.ts --excludePrivate false --excludeProtected false --excludeExternals false",
    "docs:watch": "typedoc --out docs src/ShadowMapManager.ts --watch --excludePrivate false --excludeProtected false --excludeExternals false",
    "copy-types": "rimraf ../../rendera-types && mkdir ../../rendera-types && copyfiles -u 1 \"../modules/*.d.ts\" \"../modules/*.d.ts.map\" ../../rendera-types/ && node ../../create-types-package.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@gltf-transform/core": "^4.1.1",
    "@gltf-transform/extensions": "^4.1.1",
    "@gltf-transform/functions": "^4.1.1",
    "gl-matrix": "^3.4.3",
    "workerpool": "^9.2.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "@types/node": "^22.9.0",
    "@types/workerpool": "^6.4.7",
    "copyfiles": "^2.4.1",
    "http-server": "^14.1.1",
    "rimraf": "^6.0.1",
    "rollup": "^4.25.0",
    "tslib": "^2.8.1",
    "typedoc": "^0.27.6",
    "typedoc-plugin-markdown": "^4.4.1",
    "typescript": "^5.6.3",
    "util": "^0.12.5"
  },
  "typedocOptions": {
    "entryPoints": [
      "src/ShadowMapManager.ts"
    ],
    "out": "docs",
    "name": "Shadow Mapping Documentation",
    "includeVersion": true,
    "categorizeByGroup": true,
    "categoryOrder": [
      "Constructor",
      "Properties",
      "Methods",
      "*"
    ],
    "readme": "none",
    "plugin": [
      "typedoc-plugin-markdown"
    ],
    "theme": "default"
  }
}
